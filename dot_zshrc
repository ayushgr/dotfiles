#!/bin/zsh
# Interactive shell setup: prompt, plugins, completions, aliases, keybindings.
# Managed by chezmoi. PATH and environment live in .zprofile.
# Device-specific interactive setup goes in ~/.zshrc.local.

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# oh-my-zsh lib files write here
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d $ZSH_CACHE_DIR ]] || mkdir -p $ZSH_CACHE_DIR

# Completion cache: skip compinit's full scan (~25ms/shell) and rebuild at most every
# 20 hours. After installing a tool, run `run-compinit -f` to pick up its completions now.
zstyle ':plugin:ez-compinit' 'use-cache' yes

# Suggest from history first, then from what tab completion would offer.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
# Bind autosuggest widgets once instead of before every prompt (~9ms per prompt).
# Safe because every widget-defining plugin loads before the first prompt.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1

# Load zsh plugins from a static bundle, regenerated only when .zsh_plugins.txt changes.
# antidote itself is autoloaded: none of it runs at startup, and `antidote update` etc.
# load it on first use. See https://github.com/mattmc3/antidote#performance
fpath=(/opt/homebrew/opt/antidote/share/antidote/functions $fpath)
autoload -Uz antidote
zsh_plugins=${ZDOTDIR:-$HOME}/.zsh_plugins
[[ $zsh_plugins.zsh -nt $zsh_plugins.txt ]] || antidote bundle <$zsh_plugins.txt >|$zsh_plugins.zsh
source $zsh_plugins.zsh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh


### Set up fzf -> Taken from https://www.josean.com/posts/7-amazing-cli-tools
# Consider setting up previews like in the link above
  source <(fzf --zsh)
  export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"

  # Use fd (https://github.com/sharkdp/fd) for listing path candidates.
  # - The first argument to the function ($1) is the base path to start traversal
  # - See the source code (completion.{bash,zsh}) for the details.
  _fzf_compgen_path() {
    fd --hidden --exclude .git . "$1"
  }

  # Use fd to generate the list for directory completion
  _fzf_compgen_dir() {
    fd --type=d --hidden --exclude .git . "$1"
  }
###

### Set up fzf-tab (tab completion menu via fzf)
  zstyle ':completion:*:*:*:*:*' menu no               # replaces oh-my-zsh's select menu
  zstyle ':completion:*:descriptions' format '[%d]'    # group headers; switch groups with < >
  zstyle ':fzf-tab:*' switch-group '<' '>'
  zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always --icons=always $realpath'
###


# Device-specific interactive setup. Not version controlled.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

### Set up zoxide
# Must stay at the very end: zoxide warns if anything reconfigures the shell after it.
# `cd` -> `z` is an abbreviation (zsh-abbr), not an alias, so scripts and agents get the real cd.
  eval "$(zoxide init zsh)"
###
