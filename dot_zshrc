#!/bin/zsh
# Core zsh configuration
# This file is managed by chezmoi
# Local customizations should go in ~/.zshrc.local

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export PATH="/opt/homebrew/bin:$PATH"

# Source a command's shell-init output from a cache instead of re-running it
# every startup. These commands print identical text on every invocation, so
# forking them each time (~4-7ms apiece, against a ~2.7ms fork floor) buys
# nothing. Caches go stale on tool upgrade: run `zsh-init-refresh` after
# `brew upgrade`.
_zsh_init_cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh-init
cached_eval() {
  local name=$1; shift
  local f=$_zsh_init_cache/$name.zsh
  if [[ ! -s $f ]]; then
    mkdir -p $_zsh_init_cache
    local tmp=$f.tmp.$$
    if "$@" > $tmp; then
      mv -f $tmp $f
    else
      rm -f $tmp
      return 1
    fi
  fi
  source $f
}
zsh-init-refresh() { rm -rf $_zsh_init_cache; echo "zsh init cache cleared; restart your shell"; }

# oh-my-zsh lib files expect this; normally the use-omz shim would set it.
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d $ZSH_CACHE_DIR ]] || mkdir -p $ZSH_CACHE_DIR

# Load zsh plugins from a static bundle file generated by antidote.
# antidote itself is only sourced when the bundle needs regenerating -- once the
# static file exists, startup just sources it, and antidote never loads at all.
# (`brew --prefix` is hardcoded here too: it cost ~12ms to print a constant.)
#
# The filter allowlists the oh-my-zsh lib files actually wanted instead of silently
# loading new files added upstream. Filtering happens only at regeneration, so
# startup just sources the finished file.
#
# oh-my-zsh lib files call `compdef` while being sourced, but compinit (which
# defines compdef) only runs afterwards. use-omz solved this by queueing those
# calls; this stub does the same in eight lines. Replayed after compinit below.
typeset -ga _deferred_compdefs
compdef() { _deferred_compdefs+=( "${(j: :)${(q)@}}" ) }

_zsh_plugins=${ZDOTDIR:-$HOME}/.zsh_plugins.zsh
if [[ ! $_zsh_plugins -nt ${ZDOTDIR:-$HOME}/.zsh_plugins.txt ]]; then
  source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh
  _zsh_plugins_tmp=$_zsh_plugins.tmp.$$
  if antidote bundle < ${ZDOTDIR:-$HOME}/.zsh_plugins.txt | awk '
    /ohmyzsh.*\/lib\// {
      if ($0 !~ /\/lib\/(clipboard|completion|directories|functions|grep|history|key-bindings|misc|termsupport)\.zsh/) next
    }
    /powerlevel9k\.zsh-theme/ { next }
    { print }
  ' > $_zsh_plugins_tmp; then
    mv -f $_zsh_plugins_tmp $_zsh_plugins
  else
    rm -f $_zsh_plugins_tmp
    return 1
  fi
fi
if [[ ! $_zsh_plugins.zwc -nt $_zsh_plugins ]]; then
  _zsh_plugins_tmp=$_zsh_plugins.tmp.$$.zwc
  if zcompile -R $_zsh_plugins_tmp $_zsh_plugins; then
    mv -f $_zsh_plugins_tmp $_zsh_plugins.zwc
  else
    rm -f $_zsh_plugins_tmp
  fi
fi
source $_zsh_plugins

# Completion init. use-omz used to own this; without it we run compinit
# ourselves. Rebuild the dump at most once a day, otherwise load it with -C
# (skips the expensive security audit of every fpath directory), and byte-compile
# in the background so the next shell reads bytecode.
autoload -Uz compinit
_zcompdump=$ZSH_CACHE_DIR/zcompdump-${ZSH_VERSION}
if [[ -n $_zcompdump(#qN.mh-24) ]]; then
  compinit -C -d $_zcompdump
else
  compinit -d $_zcompdump
  { zcompile -R $_zcompdump } &!
fi

# compinit has now defined the real compdef; replay what the lib files queued.
for _d in $_deferred_compdefs; do eval "compdef $_d"; done
unset _deferred_compdefs _d _zsh_plugins_tmp

export PATH="/Users/ayushgr/.local/bin:$PATH"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
# Byte-compiled for the same reason: it's ~1700 lines parsed on every startup.
if [[ -f ~/.p10k.zsh ]]; then
  if [[ ! ~/.p10k.zsh.zwc -nt ~/.p10k.zsh ]]; then
    _p10k_zcomp=~/.p10k.tmp.$$.zwc
    if zcompile -R $_p10k_zcomp ~/.p10k.zsh; then
      mv -f $_p10k_zcomp ~/.p10k.zsh.zwc
    else
      rm -f $_p10k_zcomp
    fi
  fi
  source ~/.p10k.zsh
  unset _p10k_zcomp
fi


### Set up fzf -> Taken from https://www.josean.com/posts/7-amazing-cli-tools
# Consider setting up previews like in the link above
  cached_eval fzf fzf --zsh
  export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"

  # Use fd (https://github.com/sharkdp/fd) for listing path candidates.
  # - The first argument to the function ($1) is the base path to start traversal
  # - See the source code (completion.{bash,zsh}) for the details.
  _fzf_compgen_path() {
    fd --hidden --exclude .git . "$1"
  }

  # Use fd to generate the list for directory completion
  _fzf_compgen_dir() {
    fd --type=d --hidden --exclude .git . "$1"
  }
###

### Set up bat
  export BAT_THEME="Monokai Extended Origin"
###

### Tmux aliases
  alias tm="tmux attach || tmux"
###


# Source local zshrc if it exists
# This allows for local customizations that aren't version controlled
if [[ -f ~/.zshrc.local ]]; then
    source ~/.zshrc.local
fi

### Set up zoxide
# Must stay at the very end: zoxide's init wraps `cd` and warns if anything
# reconfigures the shell after it (which ~/.zshrc.local above does).
  cached_eval zoxide zoxide init zsh
  alias cd="z"
