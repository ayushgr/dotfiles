<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>Dotfiles</string>
    <key>settings</key>
    <array>
        <!-- Codex reads #NN000000 as ANSI index NN and #00000001 as terminal default. -->
        <dict>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>#00000001</string>
                <key>background</key>
                <string>#00000001</string>
            </dict>
        </dict>
        <dict>
            <key>scope</key>
            <string>comment</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>#07000000</string>
            </dict>
        </dict>
        <!-- Codex also uses syntax scopes for status line colors: path, usage,
             and limits are muted, branches are green, and models are yellow. -->
        <dict>
            <key>scope</key>
            <string>string, constant.numeric, constant.language</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>#07000000</string>
            </dict>
        </dict>
        <dict>
            <key>scope</key>
            <string>entity.name.function, support.function, markup.inserted</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>#02000000</string>
            </dict>
        </dict>
        <dict>
            <key>scope</key>
            <string>constant, support.constant, entity.name.type, support.type, support.class</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>#03000000</string>
            </dict>
        </dict>
        <dict>
            <key>scope</key>
            <string>keyword, storage</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>#05000000</string>
            </dict>
        </dict>
        <dict>
            <key>scope</key>
            <string>invalid, markup.deleted</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>#01000000</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>
