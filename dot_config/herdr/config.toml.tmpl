{{- $t := index .themes .theme -}}
onboarding = false



# ── Terminal ──────────────────────────────────────────────────────────────────

[terminal]
default_shell = "zsh"
shell_mode = "auto"
new_cwd = "follow"          # new panes open in current pane's directory

# ── Keybindings ───────────────────────────────────────────────────────────────

[keys]
prefix = "ctrl+a"
switch_workspace = "prefix+1..9"  # cmd+1-9 → switch spaces

# Splits — triggered via ghostty cmd+d / cmd+shift+d → C-a v / C-a -
split_vertical   = ["prefix+v", "ctrl+alt+d"]
split_horizontal = ["prefix+minus", "ctrl+alt+shift+d"]

# Pane cycling — triggered via ghostty cmd+] / cmd+[ → C-a ] / C-a [
cycle_pane_next     = ["prefix+]", "ctrl+alt+]"]
cycle_pane_previous = ["prefix+[", "ctrl+alt+["]

# Directional pane focus (prefix only)
focus_pane_left  = "prefix+h"
focus_pane_right = "prefix+l"
focus_pane_up    = "prefix+k"
focus_pane_down  = "prefix+j"

# Zoom — triggered via ghostty cmd+z → C-a z
zoom = ["prefix+z", "ctrl+alt+z"]

# Jump to the agent that last pinged/notified
open_notification_target = "prefix+a"

# ── Theme ─────────────────────────────────────────────────────────────────────

[theme]
# Every color token is overridden below from the active theme (see README),
# so the built-in base theme only matters as a fallback.
name = "kanagawa"

[theme.custom]
panel_bg = "reset"          # transparent — inherits ghostty's background-opacity
surface0    = "{{ $t.bg_2 }}"
surface1    = "{{ $t.ui }}"
surface_dim = "{{ $t.ui_2 }}"
overlay0    = "{{ $t.tx_2 }}"     # brighter — counters DIM on agent labels
overlay1    = "{{ $t.tx_3 }}"
text        = "{{ $t.tx }}"
subtext0    = "{{ $t.tx }}"     # bright agent labels
accent      = "{{ $t.accent }}"
blue        = "{{ $t.blue }}"
teal        = "{{ $t.cyan }}"
green       = "{{ $t.green }}"
yellow      = "{{ $t.yellow }}"
peach       = "{{ $t.orange }}"
red         = "{{ $t.red }}"
mauve       = "{{ $t.purple }}"

# ── UI ────────────────────────────────────────────────────────────────────────

[ui]
mouse_capture = true
confirm_close = false       # matches ghostty: confirm-close-surface = false
prompt_new_tab_name = false
pane_borders = false
pane_gaps = false
sidebar_width = 32

agent_panel_sort = "spaces"
[ui.toast]
delivery = "herdr"

# ── Session ───────────────────────────────────────────────────────────────────

[session]
resume_agents_on_restore = true

# ── Advanced ──────────────────────────────────────────────────────────────────

[advanced]
scrollback_limit_bytes = 52428800  # ~50 MB
