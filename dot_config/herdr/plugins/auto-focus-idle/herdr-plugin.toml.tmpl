id = "ayushgr.auto-focus-idle"
name = "Auto-focus Idle Agent"
version = "0.1.0"
min_herdr_version = "0.6.10"
description = "Flash terminal bell and switch to an agent pane when it goes idle"
platforms = ["macos"]

[[events]]
on = "pane.agent_status_changed"
command = ["bash", "{{ .chezmoi.homeDir }}/.config/herdr/plugins/auto-focus-idle/on-agent-status.sh"]
