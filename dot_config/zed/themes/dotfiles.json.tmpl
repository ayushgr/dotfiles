{{- $t := index .themes .theme -}}
{{- $dark := eq $t.appearance "dark" -}}
{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Dotfiles",
  "author": "Generated from .chezmoidata/themes/{{ .theme }}.toml — switch with `./theme.sh <name>`",
  "themes": [
    {
      "name": "Dotfiles",
      "appearance": "{{ $t.appearance }}",
      "style": {
        "background": "{{ $t.bg_2 }}",
        "surface.background": "{{ $t.bg_2 }}",
        "elevated_surface.background": "{{ $t.bg_2 }}",
        "panel.background": "{{ $t.bg_2 }}",
        "title_bar.background": "{{ $t.bg_2 }}",
        "title_bar.inactive_background": "{{ $t.bg_2 }}",
        "status_bar.background": "{{ $t.bg_2 }}",
        "toolbar.background": "{{ $t.bg }}",
        "tab_bar.background": "{{ $t.bg_2 }}",
        "tab.inactive_background": "{{ $t.bg_2 }}",
        "tab.active_background": "{{ $t.bg }}",

        "border": "{{ $t.ui }}",
        "border.variant": "{{ $t.ui }}",
        "border.focused": "{{ $t.accent }}",
        "border.selected": "{{ $t.accent }}",
        "border.disabled": "{{ $t.ui }}",
        "border.transparent": "#00000000",
        "panel.focused_border": "{{ $t.accent }}",
        "pane.focused_border": "{{ $t.accent }}",
        "pane_group.border": "{{ $t.ui }}",

        "element.background": "{{ $t.ui }}",
        "element.hover": "{{ $t.ui_2 }}",
        "element.active": "{{ $t.ui_3 }}",
        "element.selected": "{{ $t.ui_3 }}",
        "element.disabled": "{{ $t.ui }}",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{ $t.ui }}",
        "ghost_element.active": "{{ $t.ui_2 }}",
        "ghost_element.selected": "{{ $t.ui_2 }}",
        "ghost_element.disabled": "#00000000",
        "drop_target.background": "{{ $t.accent }}33",

        "text": "{{ $t.tx }}",
        "text.muted": "{{ $t.tx_2 }}",
        "text.placeholder": "{{ $t.tx_3 }}",
        "text.disabled": "{{ $t.tx_3 }}",
        "text.accent": "{{ $t.accent }}",
        "icon": "{{ $t.tx }}",
        "icon.muted": "{{ $t.tx_2 }}",
        "icon.placeholder": "{{ $t.tx_3 }}",
        "icon.disabled": "{{ $t.tx_3 }}",
        "icon.accent": "{{ $t.accent }}",
        "link_text.hover": "{{ $t.cyan }}",

        "search.match_background": "{{ $t.yellow }}55",
        "scrollbar.thumb.background": "{{ $t.tx_3 }}55",
        "scrollbar.thumb.hover_background": "{{ $t.tx_3 }}aa",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "editor.foreground": "{{ $t.tx }}",
        "editor.background": "{{ $t.bg }}",
        "editor.gutter.background": "{{ $t.bg }}",
        "editor.subheader.background": "{{ $t.bg_2 }}",
        "editor.active_line.background": "{{ $t.bg_2 }}",
        "editor.highlighted_line.background": "{{ $t.ui }}",
        "editor.line_number": "{{ $t.tx_3 }}",
        "editor.active_line_number": "{{ $t.tx }}",
        "editor.invisible": "{{ $t.ui_3 }}",
        "editor.wrap_guide": "{{ $t.ui }}",
        "editor.active_wrap_guide": "{{ $t.ui_2 }}",
        "editor.indent_guide": "{{ $t.ui }}",
        "editor.indent_guide_active": "{{ $t.ui_3 }}",
        "editor.document_highlight.read_background": "{{ $t.accent }}26",
        "editor.document_highlight.write_background": "{{ $t.accent }}40",

        "terminal.background": "{{ $t.bg }}",
        "terminal.foreground": "{{ $t.tx }}",
        "terminal.bright_foreground": "{{ $t.tx }}",
        "terminal.dim_foreground": "{{ $t.tx_2 }}",
        "terminal.ansi.black": "{{ if $dark }}{{ $t.bg }}{{ else }}{{ $t.tx }}{{ end }}",
        "terminal.ansi.red": "{{ $t.red }}",
        "terminal.ansi.green": "{{ $t.green }}",
        "terminal.ansi.yellow": "{{ $t.yellow }}",
        "terminal.ansi.blue": "{{ $t.blue }}",
        "terminal.ansi.magenta": "{{ $t.magenta }}",
        "terminal.ansi.cyan": "{{ $t.cyan }}",
        "terminal.ansi.white": "{{ $t.tx_2 }}",
        "terminal.ansi.bright_black": "{{ $t.tx_3 }}",
        "terminal.ansi.bright_red": "{{ $t.red_2 }}",
        "terminal.ansi.bright_green": "{{ $t.green_2 }}",
        "terminal.ansi.bright_yellow": "{{ $t.yellow_2 }}",
        "terminal.ansi.bright_blue": "{{ $t.blue_2 }}",
        "terminal.ansi.bright_magenta": "{{ $t.magenta_2 }}",
        "terminal.ansi.bright_cyan": "{{ $t.cyan_2 }}",
        "terminal.ansi.bright_white": "{{ if $dark }}{{ $t.tx }}{{ else }}{{ $t.ui_3 }}{{ end }}",

        "error": "{{ $t.red }}",
        "error.background": "{{ $t.red }}26",
        "error.border": "{{ $t.red }}66",
        "warning": "{{ $t.orange }}",
        "warning.background": "{{ $t.orange }}26",
        "warning.border": "{{ $t.orange }}66",
        "info": "{{ $t.blue }}",
        "info.background": "{{ $t.blue }}26",
        "info.border": "{{ $t.blue }}66",
        "success": "{{ $t.green }}",
        "success.background": "{{ $t.green }}26",
        "success.border": "{{ $t.green }}66",
        "hint": "{{ $t.tx_2 }}",
        "hint.background": "{{ $t.ui }}",
        "hint.border": "{{ $t.ui_2 }}",
        "predictive": "{{ $t.tx_3 }}",
        "predictive.background": "{{ $t.bg_2 }}",
        "predictive.border": "{{ $t.ui }}",
        "created": "{{ $t.green }}",
        "created.background": "{{ $t.green }}26",
        "created.border": "{{ $t.green }}66",
        "modified": "{{ $t.yellow }}",
        "modified.background": "{{ $t.yellow }}26",
        "modified.border": "{{ $t.yellow }}66",
        "deleted": "{{ $t.red }}",
        "deleted.background": "{{ $t.red }}26",
        "deleted.border": "{{ $t.red }}66",
        "renamed": "{{ $t.blue }}",
        "renamed.background": "{{ $t.blue }}26",
        "renamed.border": "{{ $t.blue }}66",
        "conflict": "{{ $t.magenta }}",
        "conflict.background": "{{ $t.magenta }}26",
        "conflict.border": "{{ $t.magenta }}66",
        "hidden": "{{ $t.tx_3 }}",
        "hidden.background": "{{ $t.bg_2 }}",
        "hidden.border": "{{ $t.ui }}",
        "ignored": "{{ $t.tx_3 }}",
        "ignored.background": "{{ $t.bg_2 }}",
        "ignored.border": "{{ $t.ui }}",
        "unreachable": "{{ $t.tx_2 }}",
        "unreachable.background": "{{ $t.bg_2 }}",
        "unreachable.border": "{{ $t.ui }}",
        "version_control.added": "{{ $t.green }}",
        "version_control.modified": "{{ $t.yellow }}",
        "version_control.deleted": "{{ $t.red }}",

        "players": [
          { "cursor": "{{ $t.tx }}", "background": "{{ $t.tx }}", "selection": "{{ $t.ui_3 }}" },
          { "cursor": "{{ $t.magenta }}", "background": "{{ $t.magenta }}", "selection": "{{ $t.magenta }}40" },
          { "cursor": "{{ $t.orange }}", "background": "{{ $t.orange }}", "selection": "{{ $t.orange }}40" },
          { "cursor": "{{ $t.purple }}", "background": "{{ $t.purple }}", "selection": "{{ $t.purple }}40" },
          { "cursor": "{{ $t.cyan }}", "background": "{{ $t.cyan }}", "selection": "{{ $t.cyan }}40" },
          { "cursor": "{{ $t.green }}", "background": "{{ $t.green }}", "selection": "{{ $t.green }}40" },
          { "cursor": "{{ $t.yellow }}", "background": "{{ $t.yellow }}", "selection": "{{ $t.yellow }}40" },
          { "cursor": "{{ $t.blue }}", "background": "{{ $t.blue }}", "selection": "{{ $t.blue }}40" }
        ],

        "syntax": {
          "comment": { "color": "{{ $t.tx_3 }}", "font_style": "italic" },
          "comment.doc": { "color": "{{ $t.tx_2 }}", "font_style": "italic" },
          "keyword": { "color": "{{ $t.green }}" },
          "function": { "color": "{{ $t.orange }}" },
          "function.method": { "color": "{{ $t.orange }}" },
          "constructor": { "color": "{{ $t.orange }}" },
          "string": { "color": "{{ $t.cyan }}" },
          "string.escape": { "color": "{{ $t.magenta }}" },
          "string.regex": { "color": "{{ $t.magenta }}" },
          "string.special": { "color": "{{ $t.magenta }}" },
          "string.special.symbol": { "color": "{{ $t.magenta }}" },
          "number": { "color": "{{ $t.purple }}" },
          "boolean": { "color": "{{ $t.purple }}" },
          "constant": { "color": "{{ $t.yellow }}" },
          "type": { "color": "{{ $t.yellow }}" },
          "enum": { "color": "{{ $t.yellow }}" },
          "variant": { "color": "{{ $t.yellow }}" },
          "variable": { "color": "{{ $t.tx }}" },
          "variable.special": { "color": "{{ $t.magenta }}" },
          "property": { "color": "{{ $t.blue }}" },
          "attribute": { "color": "{{ $t.blue }}" },
          "tag": { "color": "{{ $t.blue }}" },
          "label": { "color": "{{ $t.blue }}" },
          "preproc": { "color": "{{ $t.magenta }}" },
          "operator": { "color": "{{ $t.tx_2 }}" },
          "punctuation": { "color": "{{ $t.tx_2 }}" },
          "punctuation.bracket": { "color": "{{ $t.tx_2 }}" },
          "punctuation.delimiter": { "color": "{{ $t.tx_2 }}" },
          "punctuation.list_marker": { "color": "{{ $t.tx_2 }}" },
          "punctuation.special": { "color": "{{ $t.magenta }}" },
          "embedded": { "color": "{{ $t.tx }}" },
          "title": { "color": "{{ $t.orange }}", "font_weight": 700 },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "link_text": { "color": "{{ $t.cyan }}" },
          "link_uri": { "color": "{{ $t.blue }}" },
          "text.literal": { "color": "{{ $t.cyan }}" },
          "hint": { "color": "{{ $t.tx_3 }}" },
          "predictive": { "color": "{{ $t.tx_3 }}", "font_style": "italic" },
          "primary": { "color": "{{ $t.tx }}" }
        }
      }
    }
  ]
}
